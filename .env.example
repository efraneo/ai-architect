# =====================================================
# AI Architect
# =====================================================

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

OPENROUTER_API_KEY=

OLLAMA_HOST=http://localhost:11434

DEFAULT_PROVIDER=openai

LOG_LEVEL=INFO

MEMORY_BACKEND=json

WORKSPACE=workspace/

AUTO_COMMIT=false

AUTO_PUSH=false

# Ejecutar la suite del proyecto antes de decidir. Encendido por defecto.
RUN_TESTS=true

# Avisar por Telegram al terminar una mejora. Apagado por defecto: es una
# llamada de red a un servicio externo.
NOTIFY=false

TELEGRAM_ENV=.env

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=
